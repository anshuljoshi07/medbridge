{
  "name": "MedBridge",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "echo 'Run: tool/dev.sh  → then open the forwarded port 8100'",
  "forwardPorts": [8080, 8100],
  "portsAttributes": {
    "8080": { "label": "MedBridge API" },
    "8100": { "label": "MedBridge app", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"] }
  }
}
